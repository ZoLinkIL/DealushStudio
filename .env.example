# Copy to .env.local for local development. Never commit real values.

# Only this Google account can sign in (comma-separated for more than one)
ALLOWED_EMAIL=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Added automatically when you connect Neon / Blob in Vercel
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Public address of the studio (used in Telegram buttons)
STUDIO_URL=https://studio.dealush.co.il

# Personal Telegram bot (NOT @DealushBot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Vercel Cron sends this as a Bearer token
CRON_SECRET=

# Key for POST /api/items (content Claude prepares). 32+ random characters.
STUDIO_API_KEY=
